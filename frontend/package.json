{
    "name": "shared-recipe-app-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate-schema": "openapi-typescript ../schema.yaml --output src/schema.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@tanstack/react-query": "^5.101.4",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-hook-form": "^7.85.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/node": "^22.20.1",
        "@types/react": "^19.1.0",
        "@types/react-dom": "^19.1.0",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.18.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "globals": "^15.14.0",
        "jiti": "^2.4.2",
        "openapi-typescript": "^7.13.0",
        "prettier": "^3.9.6",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.0"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true
    }
}
