# Copy to .env and adjust. .env is gitignored.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Credentials for the local Postgres container.
POSTGRES_DB=recipes
POSTGRES_USER=recipes
POSTGRES_PASSWORD=recipes
POSTGRES_PORT=5432

# Django reads the database from a single URL.
# Running Django on the host, Postgres in Docker:
DATABASE_URL=postgres://recipes:recipes@127.0.0.1:5432/recipes
# Running everything in Docker, compose overrides this with host "db".
